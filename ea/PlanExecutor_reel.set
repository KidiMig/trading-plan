; Réglages du compte réel (10 % de risque par trade) - PlanExecutor v1.57
; Mêmes options que le démo (feu vert de Claude, ordres de Claude, réveils, cassures, alerte mouvement brutal, coup du mois).
; Seuls les montants changent : risque, gain minimum, verrouillage, et 2 positions maximum pour que la marge de 100 € suffise.
; Les jetons (GitHubToken, RoutineToken) et l'adresse RoutineURL se saisissent dans MT5, jamais dans ce fichier.
DataBranch=reel
RiskPercent=10
MaxPositions=2
PriorityZones=0
MaxLossesPerDay=2
MinRR=1.5
DayFilter=false
BreakoutZones=true
MinStopATR=0.7
ConfirmMaxATR=0.25
MinGainMoney=5
; v1.55 : verrou à 1 fois le risque du trade (0,7 fois garanti) ; les montants fixes ne servent que si le risque du trade est inconnu.
LockTriggerR=1.0
LockKeepR=0.7
LockTriggerMoney=10
LockKeepMoney=7
Paused=false
AllowRealAccount=true
EntryStartHour=3
EntryEndHour=16
FridayCloseHour=16
NewsMinutes=0
CayenneUtcOffset=-3
Magic=20261110
TrailEnabled=true
TrailStartR=0.5
TrailBarsH1=2
ActionsEnabled=true
ActionsURL=https://raw.githubusercontent.com/kidimig/trading-plan/main/actions_reel.csv
RoutineEnabled=true
RoutineMinMinutes=10
RoutineMaxPerDay=30
ConfirmEntries=true
ConfirmTimeoutMin=30
ConfirmMaxAsk=2
; v1.56 : feu vert anticipé, demandé dès que le prix touche la zone ; GO = entrée à la seconde du signal pendant 30 min.
ArmEnabled=true
ArmValidMin=30
ArmBreakoutATR=0.15
; v1.57 : indices US sans entrée avant l'ouverture de Wall Street (9h30 à New York = 11h30 à Cayenne en hiver, 10h30 en été).
IndexSymbols=US500Cash#,US100Cash#
IndexOpenNY=09:30
IndexDelayMin=0
FastMoveAlert=true
FastMoveATR=0.5
FastMoveMinutes=15
CoupEnabled=true
CoupRiskPercent=30
